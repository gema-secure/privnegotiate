APP_ENV=dev
DATABASE_URL=mysql+pymysql://privnegotiate:change-me@127.0.0.1:3306/privnegotiate?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# Generate these with: python scripts/configure.py
# Required by Docker Compose; never commit the generated .env.
INVITE_TOKEN_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
WEB_PORT=8080

# Optional paid OCR. Existing active member tokens also authorize OCR.
MENU_OCR_ACCESS_TOKEN=
MENU_OCR_REQUESTS_PER_MINUTE=5
MENU_OCR_GLOBAL_REQUESTS_PER_MINUTE=20
MENU_OCR_TIMEOUT_SECONDS=10
MENU_OCR_MAX_CONCURRENT=4
MENU_IMAGE_MAX_BYTES=6291456
MAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_VISION_MODEL=qwen2.5-vl-72b-instruct
LLM_TEXT_ENABLED=false
MAAS_TEXT_MODEL=qwen2.5-72b-instruct
MAAS_TIMEOUT_SECONDS=60

SOLVER_TIME_LIMIT_SECONDS=10
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
WORKER_LOOP_INTERVAL_SECONDS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
HEALTH_TIMEOUT_SECONDS=0.5
