# 本地开发环境变量。容器部署请改用 deploy/.env.example。
# 后端从启动目录或上一级目录读取 .env：在 backend/ 下启动时，把本文件复制到仓库根 .env。

APP_ENV=dev
LOG_LEVEL=INFO

# 缺省可用 SQLite 临时库：sqlite+pysqlite:///./dev.db
DATABASE_URL=mysql+pymysql://privnegotiate:change-me@127.0.0.1:3306/privnegotiate?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# 邀请令牌的 HMAC 密钥。源码默认值是 dev-only-invite-secret，生产必须覆盖，
# 否则任何人可离线伪造任意协商的邀请令牌。生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INVITE_TOKEN_SECRET=dev-only-invite-secret

ANSWER_DEADLINE_SECONDS=600
SOLVER_TIME_LIMIT_SECONDS=10
MAX_MEMBERS=6

# outbox → Redis 投影 worker
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
WORKER_LOOP_INTERVAL_SECONDS=1

# 华为云 MaaS：菜单截图识别（留空则该入口不可用，核心协商不受影响）
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=
MAAS_VISION_MODEL=qwen2.5-vl-72b-instruct
MAAS_TIMEOUT_SECONDS=60
MENU_IMAGE_MAX_BYTES=6291456

# 文本 LLM 三入口（底线解析 / 问题措辞 / 顾虑整理）。关闭时走固定模板与结构化表单。
LLM_TEXT_ENABLED=false
MAAS_TEXT_MODEL=qwen2.5-72b-instruct
LLM_MAX_RETRIES=2
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
