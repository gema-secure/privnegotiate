# 容器部署环境变量。
# 用法：cd deploy && cp .env.example .env，填好密码与密钥后
#   本地全量：docker compose --profile local-db up -d --build
#   云上 RDS/DCS：docker compose up -d --build
# 本文件同时是 compose 的插值源和容器 env_file，必须位于 deploy/.env。

APP_ENV=prod
LOG_LEVEL=INFO

# ---- 数据库 ----
# 本地编排（--profile local-db）主机名固定为 mysql；密码必须与 MYSQL_PASSWORD 完全一致，
# 否则 api 报 Access denied，而 mysql 容器本身仍然 healthy。
# 华为云 RDS 改为内网地址，例如：
#   mysql+pymysql://privnegotiate:<密码>@rm-xxxx.mysql.rds.myhuaweicloud.com:3306/privnegotiate?charset=utf8mb4
DATABASE_URL=mysql+pymysql://privnegotiate:CHANGE_ME_DB_PASSWORD@mysql:3306/privnegotiate?charset=utf8mb4

# ---- Redis ----
# 本地编排：redis://redis:6379/0
# 华为云 DCS（带密码）：redis://:<密码>@<DCS 内网地址>:6379/0
REDIS_URL=redis://redis:6379/0

# ---- 仅本地 mysql 容器使用，云上走 RDS 时可留空 ----
MYSQL_DATABASE=privnegotiate
MYSQL_USER=privnegotiate
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ---- 安全（必填）----
# 不设置则 compose 拒绝启动 api。源码默认值 dev-only-invite-secret 会让邀请令牌可被离线伪造。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
INVITE_TOKEN_SECRET=

# ---- 对外端口 ----
WEB_PORT=80

# ---- 协商与求解 ----
ANSWER_DEADLINE_SECONDS=600
SOLVER_TIME_LIMIT_SECONDS=10
MAX_MEMBERS=15

# ---- outbox → Redis 投影 worker ----
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
WORKER_LOOP_INTERVAL_SECONDS=1

# ---- 华为云 MaaS（可选，留空则自动降级为模板/表单）----
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=
MAAS_VISION_MODEL=qwen2.5-vl-72b-instruct
MAAS_TIMEOUT_SECONDS=60
MENU_IMAGE_MAX_BYTES=6291456

LLM_TEXT_ENABLED=false
MAAS_TEXT_MODEL=qwen2.5-72b-instruct
LLM_MAX_RETRIES=2
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
